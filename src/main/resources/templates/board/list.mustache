{{> layout/header}}

<div class="container p-5">

    <!-- 검색 폼 -->
    <!-- action=/board/list, method=GET 이라서 submit 시 ?keyword=...&page=1&size=... 형태의 URL 이 만들어진다 -->
    <div class="card mb-4">
        <div class="card-body">
            <form action="/board/list" method="GET" class="row g-3">
                <div class="col-md-8">
                    <!-- value="{{keyword}}" 로 현재 검색어를 input 에 유지.
                         keyword 가 빈 문자열이면 value="" 가 되어 placeholder 가 다시 보인다. -->
                    <input type="text"
                           class="form-control"
                           name="keyword"
                           placeholder="제목 또는 내용으로 검색..."
                           value="{{keyword}}">
                </div>
                <div class="col-md-2">
                    <!-- 검색을 새로 하면 무조건 1페이지부터 보여준다.
                         size 는 사용자가 보던 페이지 크기를 그대로 유지. -->
                    <input type="hidden" name="page" value="1">
                    <input type="hidden" name="size" value="{{boardPage.size}}">
                    <button type="submit" class="btn btn-primary w-100">검색</button>
                </div>
                <div class="col-md-2">
                    <!-- 초기화: 쿼리스트링 없이 목록 첫 페이지로 -->
                    <a href="/board/list" class="btn btn-secondary w-100">초기화</a>
                </div>
            </form>
        </div>
    </div>

    {{#boardPage.list}}
        <div class="card mb-3">
            <div class="card-body">
                <h4 class="card-title mb-3">{{title}}</h4>
                <p class="text-muted">
                    작성자: {{username}} | 작성일: {{createdAt}}
                </p>
                <a href="/board/{{id}}" class="btn btn-primary">상세보기</a>
            </div>
        </div>
    {{/boardPage.list}}

    {{^boardPage.list}}
        <div class="text-center mt-5 mb-2">
            <h5>등록된 게시글이 없습니다</h5>
            <p class="text-muted">첫 번째 게시글을 작성해보세요!</p>
            <a href="/board/save" class="btn btn-primary">새글쓰기</a>
        </div>
    {{/boardPage.list}}

    {{#boardPage.totalElements}}
    <!-- 페이지 네비게이션 -->
    <!-- 페이지 링크 끝에 "{{#keyword}}&keyword={{keyword}}{{/keyword}}" 를 붙여서
         검색 중 페이지를 옮겨도 검색어가 유지되도록 한다.
         keyword 가 빈 문자열이면 #섹션이 렌더링되지 않아 &keyword= 가 안 붙는다. -->
    <ul class="pagination d-flex justify-content-center">
        <!-- 이전 페이지 버튼 (첫 페이지면 disabled) -->
        <li class="page-item {{#boardPage.first}}disabled{{/boardPage.first}}">
            <a class="page-link"
               href="/board/list?page={{boardPage.prevPage}}&size={{boardPage.size}}{{#keyword}}&keyword={{keyword}}{{/keyword}}">이전</a>
        </li>

        <!-- 페이지 번호 윈도우 (현재 페이지 기준 앞뒤 2페이지) -->
        <!-- pageNumbers 는 PageItem(number, active) 목록 -->
        {{#boardPage.pageNumbers}}
            <li class="page-item {{#active}}active{{/active}}">
                <a class="page-link"
                   href="/board/list?page={{number}}&size={{boardPage.size}}{{#keyword}}&keyword={{keyword}}{{/keyword}}">{{number}}</a>
            </li>
        {{/boardPage.pageNumbers}}

        <!-- 다음 페이지 버튼 (마지막 페이지면 disabled) -->
        <li class="page-item {{#boardPage.last}}disabled{{/boardPage.last}}">
            <a class="page-link"
               href="/board/list?page={{boardPage.nextPage}}&size={{boardPage.size}}{{#keyword}}&keyword={{keyword}}{{/keyword}}">다음</a>
        </li>
    </ul>
    {{/boardPage.totalElements}}

</div>

{{> layout/footer}}
